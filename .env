# ── Required ──────────────────────────────────────────────────────────
# ── LLM Fallback Chain: Nous Portal → Gemini → Ollama ────────────────
# Priority 1: Nous Research Portal (free tier, stepfun/step-3.7-flash)
# Get a key at https://nousresearch.com/portal — OpenAI-compatible API
NOUS_API_KEY=sk-nous-ejjBSDyth6A8TGyTtpk8hcgQ3xwAVhb3
NOUS_MODEL=stepfun/step-3.7-flash:free

# Priority 2: Gemini (optional fallback)
# Used by server.ts (React dashboard) for the optional Gemini-powered SMC
# analysis endpoint (/api/analyze). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyBAeKLu71Ve9hna086sxKjJ4dJjsnXoddY

# ── Optional overrides ───────────────────────────────────────────────────
# Everything below already has a working default for the Docker Compose
# network (container-name DNS) and for hermes_rpc running on the Windows
# host. Only uncomment/change if your setup differs.
HERMES_HOME_DIR=C:\Users\user\.hermes
HERMES_SKILLS_DIR=C:\Users\user\AppData\Local\hermes\skills
HERMES_Trading_SKILLS_DIR=C:\Users\user\AppData\Local\hermes\skills\trading
HERMES_LOG_DIR=C:\Users\user\Desktop\hermes_claude\HermesLogs
MCP_LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR

MODEL_ANALYSIS=hermes3:latest
MODEL_CODE=hhao/qwen2.5-coder-tools:latest
MODEL_BULK=nomic-embed-text:latest
# OLLAMA_HOST/URL: use localhost when hermes_rpc runs natively on Windows.
# Change to http://host.docker.internal:11434 only if running inside a Docker container.
OLLAMA_HOST=http://localhost:11434
OLLAMA_URL=http://localhost:11434
OBSIDIAN_VAULT_ROOT=C:\Users\user\AppData\Local\hermes\obsidian
OBSIDIAN_VAULT_PATH=C:\Users\user\AppData\Local\hermes\obsidian
REDIS_URL=redis://redis:6379
MAX_DAILY_DD_PCT=4.0
MAX_WEEKLY_DD_PCT=8.0
MAX_SPREAD_PIPS=60

# ── Trading Defaults ──────────────────────────────────────────────────────
HERMES_INSTRUMENT=XAUUSD
HERMES_TIMEFRAME=M15
# Timeframes fetched together for multi-timeframe analysis
HERMES_MTF_LIST=M5,M15,H1,H4,D1
TRADING_MODE=paper
# Options: paper, live (live requires explicit unlock — see docs)
APPROVAL_REQUIRED=false
# Set to true to require manual /approve before any signal is routed

# ── Risk Management (enforced by the risk gatekeeper, not just suggested) ─
MAX_RISK_PCT=1.0
MAX_DAILY_DD=3.0
MAX_WEEKLY_DD=6.0
MIN_RR_RATIO=2.0
# Simulated balance for paper-trading risk calculations.
# Used when MT5 bridge reports balance=0.0 (demo/test environment).
PAPER_BALANCE=10000.0
# Probability (0.0–1.0) that the paper broker randomly rejects an order.
# Models real-world requotes and routing failures. Default: 1.5%
SIM_REJECT_RATE=0.015

# ── Autonomous Agent Schedule (used if running the standalone agent loop) ─
SCAN_INTERVAL_MIN=15
RESEARCH_INTERVAL_HR=4
REVIEW_INTERVAL_HR=24

# ── Service Ports (change only if you have conflicts) ─────────────────────
# These use Docker service-name DNS — containers talk to each other by service name, NOT localhost
MT5_BRIDGE_URL=http://mt5_bridge:5558
PAPER_TRADER_URL=http://paper_trader:5561
PREPROCESSOR_URL=http://preprocessor:5559
BACKTESTER_URL=http://backtester:5560
MCP_BRIDGE_URL=http://mcp_bridge:5562
# These two are host-level processes — keep localhost for Windows host access
HERMES_RPC_URL=http://localhost:7778
MCP_TRADING_PORT=7779

# ── Optional: Gemini fallback for the React dashboard's /api/gemini/analyze
# Leave blank to rely entirely on local Ollama (recommended — fully private,
# fully local, zero API cost). The dashboard auto-falls-back to Ollama if
# this key is missing or invalid.
GEMINI_API_KEY=AIzaSyBAeKLu71Ve9hna086sxKjJ4dJjsnXoddY

# ── Strategy Plugin Storage ────────────────────────────────────────────────
STRATEGY_DIR=/data/strategies

